<Window x:Class="CLB_EVENT.CuaSoChinh"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Quản Lý CLB &amp; Sự Kiện"
        Width="1280" Height="780"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Style nút điều hướng sidebar -->
        <Style x:Key="StyleNutDieuHuong" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NhomDieuHuong"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="#90A4AE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="vienNen" Background="Transparent"
                                BorderBrush="#3949AB" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="tbBieu" Text="{TemplateBinding Tag}"
                                           FontSize="18" Width="30"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="tbNhan" Text="{TemplateBinding Content}"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="vienNen" Property="Background" Value="#1E3A6E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="vienNen" Property="Background" Value="#1A3461"/>
                                <Setter TargetName="vienNen" Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Grid Grid.Column="0" Background="#16213E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Phần logo trên cùng -->
            <Border Grid.Row="0" Background="#0F3460" Padding="18,22">
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#1565C0">
                        <TextBlock Text="🎓" FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CLB &amp; EVENT" Foreground="White"
                                   FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Quản Lý Sinh Viên" Foreground="#90CAF9"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Menu điều hướng chính -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">

                <!-- Nhãn nhóm chức năng chính -->
                <TextBlock Text="CHỨC NĂNG CHÍNH" Foreground="#546E7A"
                           FontSize="10" FontWeight="Bold"
                           Margin="20,15,0,8"/>

                <RadioButton x:Name="rbTrangChu"
                             Content="Trang chủ" Tag="🏠"
                             Style="{StaticResource StyleNutDieuHuong}"
                             IsChecked="True"
                             Checked="DieuHuong_Checked"/>

                <RadioButton x:Name="rbTinTuc"
                             Content="Tin tức" Tag="📰"
                             Style="{StaticResource StyleNutDieuHuong}"
                             Checked="DieuHuong_Checked"/>

                <RadioButton x:Name="rbDangKySuKien"
                             Content="Đăng ký sự kiện" Tag="📝"
                             Style="{StaticResource StyleNutDieuHuong}"
                             Checked="DieuHuong_Checked"/>

                <RadioButton x:Name="rbThoiGianSuKien"
                             Content="Thời gian sự kiện" Tag="📅"
                             Style="{StaticResource StyleNutDieuHuong}"
                             Checked="DieuHuong_Checked"/>

                <!-- Nhãn nhóm quản lý CLB -->
                <TextBlock x:Name="tbNhanQuanLy"
                           Text="QUẢN LÝ CLB" Foreground="#546E7A"
                           FontSize="10" FontWeight="Bold"
                           Margin="20,15,0,8"
                           Visibility="Collapsed"/>

                <RadioButton x:Name="rbQuanLyCLB"
                             Content="Quản lý CLB" Tag="🏛️"
                             Style="{StaticResource StyleNutDieuHuong}"
                             Checked="DieuHuong_Checked"
                             Visibility="Collapsed"/>

                <RadioButton x:Name="rbDuyetDonCLB" Content="Duyệt đơn CLB" Tag="📋"
                             Style="{StaticResource StyleNutDieuHuong}" Checked="DieuHuong_Checked" Visibility="Collapsed"/>
                <RadioButton x:Name="rbQuanLySuKien" Content="Quản lý sự kiện" Tag="📅"
                             Style="{StaticResource StyleNutDieuHuong}" Checked="DieuHuong_Checked" Visibility="Collapsed"/>
                <RadioButton x:Name="rbQuanLyTinTuc" Content="Quản lý tin tức" Tag="📰"
                             Style="{StaticResource StyleNutDieuHuong}" Checked="DieuHuong_Checked" Visibility="Collapsed"/>

                <!-- Nhãn nhóm cá nhân -->
                <TextBlock Text="CÁ NHÂN" Foreground="#546E7A"
                           FontSize="10" FontWeight="Bold"
                           Margin="20,15,0,8"/>

                <RadioButton x:Name="rbDangKyCLB"
                             Content="Đăng ký CLB" Tag="📋"
                             Style="{StaticResource StyleNutDieuHuong}"
                             Checked="DieuHuong_Checked"/>

            </StackPanel>
            </ScrollViewer>

            <!-- Phần thông tin người dùng phía dưới sidebar -->
            <Border Grid.Row="2" Background="#0F3460" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar người dùng -->
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                            Background="#1565C0">
                        <TextBlock Text="👤" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tên và vai trò -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="tbTenNguoiDung" Text="Người dùng"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="tbVaiTro" Text="Sinh viên"
                                   Foreground="#90CAF9" FontSize="11"/>
                    </StackPanel>

                    <!-- Nút đăng xuất -->
                    <Button Grid.Column="2" Content="🚪"
                            FontSize="18" Background="Transparent"
                            BorderThickness="0" Foreground="#90CAF9"
                            Cursor="Hand" ToolTip="Đăng xuất"
                            Click="NutDangXuat_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== KHU VỰC NỘI DUNG CHÍNH ==================== -->
        <Grid Grid.Column="1" Background="#F0F2F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header trên cùng -->
            <Border Grid.Row="0" Background="White">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="6"
                                      ShadowDepth="2" Opacity="0.15"
                                      Direction="270"/>
                </Border.Effect>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thanh tìm kiếm -->
                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="20" Background="#F5F5F5"
                            MaxWidth="450" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#757575"/>
                            <TextBox x:Name="tbTimKiem"
                                     KeyDown="TimKiemChung_KeyDown" ToolTip="Nhập từ khóa và nhấn Enter để tìm tin tức"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Width="300"
                                     VerticalAlignment="Center"
                                     Foreground="#424242"/>
                        </StackPanel>
                    </Border>

                    <!-- Khu vực thông tin người dùng -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="#1565C0" Margin="0,0,10,0">
                            <TextBlock Text="👤" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="tbTenTrenHeader"
                                   Text="Người dùng"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#212121"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khu vực nội dung trang -->
            <ContentControl Grid.Row="1" x:Name="vungNoiDung"/>
        </Grid>
    </Grid>
</Window>
