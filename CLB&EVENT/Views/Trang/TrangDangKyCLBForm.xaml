<UserControl x:Class="CLB_EVENT.TrangDangKyCLBForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F0F2F5">
        <Grid Margin="25,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Form đăng ký CLB -->
            <StackPanel Grid.Column="0">

                <!-- Tiêu đề trang -->
                <Border Background="White" CornerRadius="10" Margin="0,0,0,15" Padding="25,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="50" CornerRadius="25"
                                Background="#1565C0" Margin="0,0,15,0">
                            <TextBlock Text="📋" FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Đăng Ký Tham Gia CLB"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#0D3B8C"/>
                            <TextBlock Text="Điền đầy đủ thông tin để đăng ký vào câu lạc bộ bạn muốn"
                                       FontSize="13" Foreground="#607D8B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phần 1: Thông tin cá nhân (tự động điền) -->
                <Border Background="White" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="18" CornerRadius="2"
                                        Background="#1565C0" Margin="0,0,10,0"/>
                                <TextBlock Text="THÔNG TIN CÁ NHÂN"
                                           FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                                <TextBlock Text="  (Tự động điền từ tài khoản)"
                                           FontSize="11" Foreground="#9E9E9E"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="20,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Họ và tên -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Họ và tên" FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="#F9F9F9">
                                    <TextBox x:Name="tbHoTen" BorderThickness="0"
                                             Padding="10,8" FontSize="13" IsReadOnly="True"
                                             Background="Transparent" Foreground="#424242"/>
                                </Border>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Email" FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="#F9F9F9">
                                    <TextBox x:Name="tbEmail" BorderThickness="0"
                                             Padding="10,8" FontSize="13" IsReadOnly="True"
                                             Background="Transparent" Foreground="#424242"/>
                                </Border>
                            </StackPanel>

                            <!-- Số điện thoại -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="#F9F9F9">
                                    <TextBox x:Name="tbSoDienThoai" BorderThickness="0"
                                             Padding="10,8" FontSize="13" IsReadOnly="True"
                                             Background="Transparent" Foreground="#424242"/>
                                </Border>
                            </StackPanel>

                            <!-- Lớp học -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Lớp học" FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="#F9F9F9">
                                    <TextBox x:Name="tbLopHoc" BorderThickness="0"
                                             Padding="10,8" FontSize="13" IsReadOnly="True"
                                             Background="Transparent" Foreground="#424242"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Phần 2: Chọn CLB muốn đăng ký -->
                <Border Background="White" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="18" CornerRadius="2"
                                        Background="#F57C00" Margin="0,0,10,0"/>
                                <TextBlock Text="CHỌN CLB MUỐN THAM GIA *"
                                           FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="20,15">
                            <TextBlock Text="Câu lạc bộ *" FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="0,0,0,12">
                                <ComboBox x:Name="cbChonCLB" BorderThickness="0"
                                          Padding="10,8" FontSize="13"
                                          SelectionChanged="CbChonCLB_SelectionChanged"/>
                            </Border>

                            <!-- Mô tả CLB được chọn -->
                            <Border x:Name="borderMoTaCLB" Background="#E3F2FD"
                                    CornerRadius="8" Padding="15,12"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="tbMoTaCLB" Text=""
                                               FontSize="12" Foreground="#1565C0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="tbChuNhiemCLB" Text=""
                                               FontSize="12" Foreground="#1976D2"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phần 3: Thông tin đăng ký -->
                <Border Background="White" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,15">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="18" CornerRadius="2"
                                        Background="#2E7D32" Margin="0,0,10,0"/>
                                <TextBlock Text="THÔNG TIN ĐĂNG KÝ"
                                           FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="20,15">

                            <!-- Lý do muốn tham gia -->
                            <TextBlock Text="Lý do bạn muốn tham gia CLB này *"
                                       FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="0,0,0,15">
                                <TextBox x:Name="tbLyDo" BorderThickness="0"
                                         Padding="10,8" FontSize="13"
                                         Height="80" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <!-- Kỹ năng và kinh nghiệm -->
                            <TextBlock Text="Kỹ năng và kinh nghiệm liên quan"
                                       FontSize="12" Foreground="#616161" Margin="0,0,0,5"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Background="White" Margin="0,0,0,15">
                                <TextBox x:Name="tbKyNang" BorderThickness="0"
                                         Padding="10,8" FontSize="13"
                                         Height="80" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <!-- Thời gian rảnh -->
                            <TextBlock Text="Thời gian bạn có thể tham gia sinh hoạt CLB"
                                       FontSize="12" Foreground="#616161" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <CheckBox x:Name="chkHai" Content="Thứ 2" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkBa" Content="Thứ 3" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkTu" Content="Thứ 4" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkNam" Content="Thứ 5" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkSau" Content="Thứ 6" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkBay" Content="Thứ 7" Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkChuNhat" Content="Chủ nhật"/>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thông báo kết quả -->
                <Border x:Name="borderThongBao" CornerRadius="8" Padding="15,12"
                        Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock x:Name="tbThongBao" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Nút gửi đơn -->
                <Button x:Name="nutGuiDon"
                        Content="📨 GỬI ĐƠN ĐĂNG KÝ CLB"
                        Height="50" FontSize="16" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="NutGuiDon_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="vienNut" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1565C0" Offset="0"/>
                                        <GradientStop Color="#1976D2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="vienNut" Property="Background" Value="#0D47A1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="vienNut" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- CỘT PHẢI: Lịch sử đăng ký CLB và hướng dẫn -->
            <StackPanel Grid.Column="2">

                <!-- Lịch sử đăng ký -->
                <Border Background="White" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="18,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="18" CornerRadius="2"
                                        Background="#2E7D32" Margin="0,0,10,0"/>
                                <TextBlock Text="ĐƠN ĐĂNG KÝ CỦA TÔI"
                                           FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="dsDangKyCLB" MaxHeight="300">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="18,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TenCLB}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#212121"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding NhanTrangThai}"
                                                           FontSize="11"
                                                           Foreground="{Binding MauTrangThai}"/>
                                                <TextBlock Text=" · " FontSize="11" Foreground="#9E9E9E"/>
                                                <TextBlock Text="{Binding NgayDangKy}"
                                                           FontSize="11" Foreground="#9E9E9E"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="borderTrongLichSu" Padding="20,30">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có đơn đăng ký nào"
                                           FontSize="12" Foreground="#9E9E9E"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hướng dẫn đăng ký -->
                <Border Background="White" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="4" Height="18" CornerRadius="2"
                                    Background="#F57C00" Margin="0,0,10,0"/>
                            <TextBlock Text="HƯỚNG DẪN ĐĂNG KÝ"
                                       FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="#E3F2FD" Margin="0,0,10,0">
                                    <TextBlock Text="1" FontSize="11" FontWeight="Bold"
                                               Foreground="#1565C0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chọn CLB bạn muốn tham gia"
                                           FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="#E3F2FD" Margin="0,0,10,0">
                                    <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                               Foreground="#1565C0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Điền đầy đủ thông tin và lý do"
                                           FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="#E3F2FD" Margin="0,0,10,0">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                               Foreground="#1565C0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nhấn 'Gửi đơn đăng ký CLB'"
                                           FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="#E3F2FD" Margin="0,0,10,0">
                                    <TextBlock Text="4" FontSize="11" FontWeight="Bold"
                                               Foreground="#1565C0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chờ xét duyệt từ BQL CLB"
                                           FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
